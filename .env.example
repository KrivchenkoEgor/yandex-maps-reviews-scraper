# ============================================
# Yandex Reviews Scraper — переменные окружения
# Скопировать как .env в корне проекта
# ============================================

# --- Антибот-защита ---
YANDEX_MIN_DELAY_SEC=2
YANDEX_MAX_DELAY_SEC=5
YANDEX_MAX_RETRIES=3
YANDEX_RETRY_BASE_DELAY_SEC=2
YANDEX_PAGE_TIMEOUT_SEC=30
YANDEX_SCROLL_PAUSE_SEC=3
YANDEX_MAX_SCROLL_ATTEMPTS=5

# --- База данных ---
DATABASE_PATH=db/ya_ot.db

# --- Кэш ---
SHOP_CACHE_TTL_HOURS=24
REVIEW_CACHE_TTL_HOURS=1

# --- Приложение ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# --- Логи ---
LOG_LEVEL=INFO
LOG_FILE=logs/ya_ot.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# --- Экспорт ---
OUTPUT_DIR=output
DEFAULT_EXPORT_FORMAT=xlsx

# --- Мониторинг ---
MONITOR_DEFAULT_INTERVAL_HOURS=24
MONITOR_CHECK_INTERVAL_MINUTES=60

# --- User-Agent ---
# Путь к файлу со списком User-Agent (опционально)
# Если не указан — используется fake-useragent
USER_AGENT_FILE=

# --- Ограничения ---
MAX_REVIEWS_PER_SHOP=10000
MAX_CONCURRENT_SHOPS=1
