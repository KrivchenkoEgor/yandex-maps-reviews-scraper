# ============================================
# Yandex Reviews Scraper — gitignore
# ============================================

# Секреты (КРИТИЧНО!)
.env
.env.local
.env.*.local
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Логи
logs/
*.log

# База данных
db/
!db/.gitkeep

# Экспорты (слишком большие для git)
output/
exports/
*.xlsx
*.csv
!output/.gitkeep

# Playwright
playwright-report/
playwright/.cache/
test-results/

# Временные файлы
tmp/
temp/
*.tmp
*.bak
*.zip
*.rar
errors.md
errors2.md
errors3.md
REPORT*.md

# Артефакты артефактов
artifacts/

# Тестовые скриншоты UI и артефакты Playwright MCP
/*.png
.playwright-mcp/

# Кэш
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.omo/

# Эксперименты (сетевые прогонщики с хардкодом)
experiment/

# Node (если Context7 установлен локально)
node_modules/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
